  InputLines:
    - // @input bool _autoAlignment = true
    - '// @input string _alignment = "start" {"hint":"Alignment of the layout. If size is flexible, alignment must match the anchor (e.g., start anchor requires start alignment).", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Stretch", "value":"stretch"}, {"label":"Stretch Spacing", "value":"stretchSpacing"}], "showIf":"_autoAlignment"}'
    - '// @input string _spacingDistribution {"hint":"How to distribute extra space when using Stretch Spacing alignment.", "widget":"combobox", "values":[{"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Evenly", "value":"spaceEvenly"}, {"label":"Space Around", "value":"spaceAround"}], "showIf":"_alignment", "showIfValue":"stretchSpacing"}'
