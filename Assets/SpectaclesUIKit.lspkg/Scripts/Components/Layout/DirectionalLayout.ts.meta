    - '// @input string _anchorX {"widget":"combobox", "values":[{"label":"Left", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"Right", "value":"end"}], "showIf":"_primaryDirection", "showIfValue":"x"}'
