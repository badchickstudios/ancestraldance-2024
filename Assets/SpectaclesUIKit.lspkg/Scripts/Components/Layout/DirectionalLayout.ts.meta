    - '// @input float _paddingBottom {"label":"Bottom", "showIf":"_primaryDirection", "showIfValue":"y"}'
    - '// @input float _paddingTop {"label":"Top", "showIf":"_primaryDirection", "showIfValue":"y"}'
    - '// @input float _paddingBack {"label":"Back", "showIf":"_primaryDirection", "showIfValue":"z"}'
    - '// @input float _paddingFront {"label":"Front", "showIf":"_primaryDirection", "showIfValue":"z"}'
