    - '// @input float _secondarySpacing = 1 {"hint":"Spacing between wrapped rows in local space centimeters.", "showIf":"_overflow", "showIfValue":"wrap"}'
    - '// @input float _secondarySize {"hint":"Limit for the secondary (wrap) axis before wrapping to tertiary (0 = no tertiary wrap).", "showIf":"_overflow", "showIfValue":"wrap"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Tertiary Axis"}'
    - '// @input string _tertiaryDirection {"widget":"combobox", "values":[{"label":"Left", "value":"-x"}, {"label":"Right", "value":"+x"}, {"label":"Down", "value":"-y"}, {"label":"Up", "value":"+y"}, {"label":"Back", "value":"-z"}, {"label":"Front", "value":"+z"}], "showIf":"_overflow", "showIfValue":"wrap"}'
    - '// @input float _tertiarySpacing = 1 {"hint":"Spacing between tertiary wrapped layers in local space centimeters.", "showIf":"_overflow", "showIfValue":"wrap"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Padding"}'
    - '// @input float _paddingStart = 2 {"label":"Start"}'
    - '// @input float _paddingEnd = 2 {"label":"End"}'
