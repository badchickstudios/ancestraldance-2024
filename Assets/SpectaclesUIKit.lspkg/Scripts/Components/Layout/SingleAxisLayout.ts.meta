    - '// @input string _anchor {"hint":"Anchor determines item position relative to origin. Start: item starts at origin, extends positive. End: item ends at origin, extends negative. Center: item centered on origin (alignment ignored).", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}]}'
    - '// @input bool _flexibleSize {"hint":"Enable flexible size. If enabled, the layout will not have bounds."}'
    - '// @input float _size = 10 {"hint":"Size of the layout in local space centimeters.", "showIf":"_flexibleSize", "showIfValue":false}'
    - '// @input float _spacing = 1 {"showIf":"_autoAlignment"}'
    - '// @input string _overflow {"widget":"combobox", "values":[{"label":"Overflow", "value":"overflow"}, {"label":"Truncate", "value":"truncate"}, {"label":"Wrap", "value":"wrap"}], "showIf":"_flexibleSize", "showIfValue":false}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Secondary Axis"}'
