  InputLines:
    - '// @ui {"widget":"group_start", "label":"Toolbar Settings"}'
    - '// @input AssignableType frame {"hint":"Optional: Frame component to attach the toolbar to. Leave empty for standalone toolbar."}'
    - '// @input bool autoHideWhenFrameNotTargeted {"hint":"When enabled, toolbar fades when not targeted. With a Frame attached, targeting the Frame shows it; otherwise targeting the toolbar shows it."}'
    - '// @input string direction {"hint":"Direction items are laid out in the toolbar.", "widget":"combobox", "values":[{"label":"Horizontal", "value":"horizontal"}, {"label":"Vertical", "value":"vertical"}]}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Size Settings"}'
    - '// @input vec2 size = "{25,5}" {"hint":"Size of the toolbar in centimeters (width, height)."}'
    - '// @input string framePosition {"hint":"Position of the toolbar relative to the Frame.", "widget":"combobox", "values":[{"label":"Bottom", "value":"bottom"}, {"label":"Top", "value":"top"}, {"label":"Left", "value":"left"}, {"label":"Right", "value":"right"}]}'
    - '// @input number frameGap = "1" {"hint":"Gap between the toolbar and the Frame in centimeters."}'
    - '// @input bool isToolbarInsideFrame {"hint":"Place toolbar inside frame (inner area) or outside. Gap applies in both cases."}'
    - '// @input bool fitToFrame {"hint":"Match toolbar size to Frame (scale factors below). Uses inner size when inside frame."}'
    - '// @input number frameSizeScaleX = "1" {"hint":"Width scale relative to Frame (1.0 = same width, 0.5 = half width). Only for horizontal fit-to-frame mode.", "showIf":"fitToFrame"}'
    - '// @input number frameSizeScaleY = "1" {"hint":"Height scale relative to Frame (1.0 = same height, 0.5 = half height). Only for vertical fit-to-frame mode.", "showIf":"fitToFrame"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Layout Settings"}'
    - '// @input number spacing = "0.5" {"hint":"Spacing between items in centimeters."}'
    - '// @input number paddingLeft = "1" {"hint":"Left padding in centimeters."}'
    - '// @input number paddingRight = "1" {"hint":"Right padding in centimeters."}'
    - '// @input number paddingTop = "0.5" {"hint":"Top padding in centimeters."}'
    - '// @input number paddingBottom = "0.5" {"hint":"Bottom padding in centimeters."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Background"}'
