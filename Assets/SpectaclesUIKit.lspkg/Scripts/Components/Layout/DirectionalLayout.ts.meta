    - '// @input string _anchorZ {"widget":"combobox", "values":[{"label":"Back", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"Front", "value":"end"}], "showIf":"_primaryDirection", "showIfValue":"z"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Child Alignment"}'
    - '// @input string _childAlignmentX {"hint":"Horizontal alignment of children (X-axis).", "widget":"combobox", "values":[{"label":"Left", "value":"-"}, {"label":"Center", "value":""}, {"label":"Right", "value":"+"}, {"label":"Stretch", "value":"*"}], "showIf":"_primaryDirection", "showIfValue":"x"}'
    - '// @input string _childAlignmentY {"hint":"Vertical alignment of children (Y-axis).", "widget":"combobox", "values":[{"label":"Bottom", "value":"-"}, {"label":"Center", "value":""}, {"label":"Top", "value":"+"}, {"label":"Stretch", "value":"*"}], "showIf":"_primaryDirection", "showIfValue":"y"}'
    - '// @input string _childAlignmentZ {"hint":"Depth alignment of children (Z-axis).", "widget":"combobox", "values":[{"label":"Back", "value":"-"}, {"label":"Center", "value":""}, {"label":"Front", "value":"+"}, {"label":"Stretch", "value":"*"}], "showIf":"_primaryDirection", "showIfValue":"z"}'
    - '// @ui {"widget":"group_end"}'
    - '// @input string _stretchModeX {"hint":"Stretch mode: Content stretches children to fill, Spacing distributes extra space between children.", "widget":"combobox", "values":[{"label":"Content", "value":"content"}, {"label":"Spacing", "value":"spacing"}], "showIf":"_childAlignmentX", "showIfValue":"*"}'
    - '// @input string _stretchModeY {"hint":"Stretch mode: Content stretches children to fill, Spacing distributes extra space between children.", "widget":"combobox", "values":[{"label":"Content", "value":"content"}, {"label":"Spacing", "value":"spacing"}], "showIf":"_childAlignmentY", "showIfValue":"*"}'
    - '// @input string _stretchModeZ {"hint":"Stretch mode: Content stretches children to fill, Spacing distributes extra space between children.", "widget":"combobox", "values":[{"label":"Content", "value":"content"}, {"label":"Spacing", "value":"spacing"}], "showIf":"_childAlignmentZ", "showIfValue":"*"}'
    - '// @input string _spacingDistributionX {"hint":"How to distribute extra space when using Stretch Spacing mode (X-axis).", "widget":"combobox", "values":[{"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Evenly", "value":"spaceEvenly"}, {"label":"Space Around", "value":"spaceAround"}], "showIf":"_stretchModeX", "showIfValue":"spacing"}'
    - '// @input string _spacingDistributionY {"hint":"How to distribute extra space when using Stretch Spacing mode (Y-axis).", "widget":"combobox", "values":[{"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Evenly", "value":"spaceEvenly"}, {"label":"Space Around", "value":"spaceAround"}], "showIf":"_stretchModeY", "showIfValue":"spacing"}'
    - '// @input string _spacingDistributionZ {"hint":"How to distribute extra space when using Stretch Spacing mode (Z-axis).", "widget":"combobox", "values":[{"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Evenly", "value":"spaceEvenly"}, {"label":"Space Around", "value":"spaceAround"}], "showIf":"_stretchModeZ", "showIfValue":"spacing"}'
    - '// @input bool _reverse {"label":"Reverse Children Items Order"}'
